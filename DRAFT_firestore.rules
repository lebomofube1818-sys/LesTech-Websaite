rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "lebomofube1818@gmail.com"
      );
    }

    // Inquiry Validation
    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'company', 'email', 'phone', 'sector', 'message', 'createdAt'])
        && data.keys().size() == 7
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.company is string && data.company.size() > 0 && data.company.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 100
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30
        && data.sector is string && data.sector.size() > 0 && data.sector.size() <= 100
        && data.message is string && data.message.size() > 0 && data.message.size() <= 5000
        && data.createdAt == request.time;
    }

    // 1. Inquiries Collection
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Admin Collection (Read-only for admins)
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
